# ─── Backend (FastAPI on Render) ─────────────────────────────
# Server-side only — Next.js /api routes proxy to this URL.
BACKEND_API_URL=https://discipline-os-backend-29ku.onrender.com

# Must exactly match JWT_SECRET_KEY on your Render backend service.
JWT_SECRET_KEY=your-render-jwt-secret

# Set to true to skip the backend and use in-memory demo auth
USE_MOCK_AUTH=false

# ─── Client API ───────────────────────────────────────────────
# Leave empty to use same-origin Next.js routes (recommended for production).
NEXT_PUBLIC_API_URL=
